# Copy to backend/.env

# SQLite for local dev. For Supabase / Neon use the Postgres URL they give you, e.g.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./traveltrack.db

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_HOURS=336

# Microsoft Entra ID app registration (Azure portal > App registrations)
# Application (client) ID, and Directory (tenant) ID. Both are GUIDs from the app's Overview page.
MS_CLIENT_ID=
MS_TENANT_ID=
ALLOWED_DOMAIN=plaksha.edu.in

# Lets you sign in with any @plaksha.edu.in address without Microsoft. NEVER enable in production.
DEV_LOGIN=true

CORS_ORIGINS=http://localhost:3000

# Web Push (VAPID). Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:travel-admin@plaksha.edu.in

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=10
MATCH_GRACE_MINUTES=15
# Rides match when both pickup and drop are within this many km of each other
MATCH_RADIUS_KM=2.0
# Photon geocoder (OpenStreetMap) used for place search. Self-host one and point here if needed
GEOCODER_URL=https://photon.komoot.io
# Create tables on startup (fine for SQLite/dev; use db/schema.sql for Supabase/Neon)
AUTO_CREATE_TABLES=true
